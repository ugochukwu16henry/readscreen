<Window x:Class="Readscreen.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Readscreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#CC1E1E1E"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Width="500"
        Height="220"
        Left="50"
        Top="50">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#AA000000" Padding="8,4">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           Text="Idle"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <TextBlock Text="Readscreen"
                           Foreground="#CCFFFFFF"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
            <TextBlock x:Name="ContentText"
                       Text="Ready"
                       Foreground="White"
                       FontSize="13"
                       TextWrapping="Wrap"
                       LineHeight="20"/>
        </ScrollViewer>
    </Grid>
</Window>
