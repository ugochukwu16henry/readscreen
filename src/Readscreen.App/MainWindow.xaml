<Window x:Class="Readscreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Readscreen Settings"
        Height="680"
        Width="720"
        MinHeight="500"
        MinWidth="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Orientation="Vertical">

            <TextBlock Text="Readscreen" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Private local AI copilot — settings and controls"
                       Foreground="Gray" Margin="0,0,0,20"/>

            <!-- Capture -->
            <GroupBox Header="Screen Capture" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Top"/>
                            <TextBox x:Name="TopBox"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Left"/>
                            <TextBox x:Name="LeftBox"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,8,0">
                            <TextBlock Text="Width"/>
                            <TextBox x:Name="WidthBox"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Height"/>
                            <TextBox x:Name="HeightBox"/>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Pick Region" Click="OnPickRegion" Margin="0,0,8,0" Padding="12,6"/>
                        <TextBlock x:Name="RegionStatus" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- AI -->
            <GroupBox Header="AI &amp; Response" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="LLM Model"/>
                    <TextBox x:Name="ModelBox" Margin="0,0,0,8"/>
                    <TextBlock Text="Answer Mode"/>
                    <ComboBox x:Name="AnswerModeBox" Margin="0,0,0,8"/>
                    <TextBlock Text="Audio Input"/>
                    <ComboBox x:Name="AudioInputModeBox" Margin="0,0,0,8"/>
                    <TextBlock Text="Poll Interval (seconds)"/>
                    <TextBox x:Name="PollBox" Margin="0,0,0,8"/>
                    <TextBlock Text="Ollama URL"/>
                    <TextBox x:Name="OllamaUrlBox"/>
                </StackPanel>
            </GroupBox>

            <!-- Overlay -->
            <GroupBox Header="Overlay" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Opacity"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" TickFrequency="0.05"
                            ValueChanged="OnOpacityChanged" Margin="0,0,0,8"/>
                    <CheckBox x:Name="MeetingAssistBox" Content="Meeting assist mode"
                              Checked="OnMeetingAssistChanged" Unchecked="OnMeetingAssistChanged"/>
                    <CheckBox x:Name="ClickThroughBox" Content="Click-through overlay"
                              Checked="OnClickThroughChanged" Unchecked="OnClickThroughChanged"/>
                    <CheckBox x:Name="AudioEnabledBox" Content="Enable audio transcription"
                              Margin="0,8,0,0"/>
                    <TextBlock Text="Listens to meeting audio, understands questions in real time, and shows the answer only on your screen."
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Documents -->
            <GroupBox Header="Presentation / Document Mode" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="SessionLabel" Text="No active document session" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="New Session" Click="OnNewSession" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Upload Document" Click="OnUploadDocument" Padding="12,6"/>
                    </StackPanel>
                    <ListBox x:Name="DocumentList" Height="100" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Memory -->
            <GroupBox Header="Personal Memory" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <Button Content="Manage Memory" Click="OnManageMemory" Padding="12,6" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <!-- Controls -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Save Settings" Click="OnSave" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Toggle Overlay (Ctrl+Shift+H)" Click="OnToggleOverlay" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Pause / Resume (Ctrl+Shift+P)" Click="OnTogglePause" Padding="16,8"/>
            </StackPanel>

            <TextBlock x:Name="StatusBar" Margin="0,16,0,0" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
